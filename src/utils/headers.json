      "💰 Balance: {balance:,}   🧩 Matches: {matches_found}/{pairs_total}   💥 Combo: ×{combo_streak}",
      "❌ Misses: {miss_count}       🕐 Board: {round}"
    ]
  },
  "pair-a-gone": {
    "lines": [
      "💰 Balance: {coins}   🕐 Round: {round}   🔢 Pairs: {pairs_left}",
      "💥 Chain: ×{chain_mult}      🏆 Score: {score}"
    ]
  },
  "default": {
    "lines": [
      "💰 Balance: {balance:,}   ⭐ Stars: {stars_text}   🕐 Round: {round}"
    ]
  }
}
