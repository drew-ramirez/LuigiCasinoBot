{
  "picture poker": {
    "lines": [
      "💰 Balance: {balance:,}   🎯 Bet: {active_bet}   ⭐ Stars: {stars_text}",
      "🃏 Hand: {player_rank}   💎 Payout: ×{payout_mult}",
      "🕐 Round: {round}           🎩 Luigi: {luigi_rank}"
    ]
  },
  "lucky stars": {
    "lines": [
      "💰 Coins: {coins}   🕐 Round: {round}   🌟 Gain: +{reward_value}",
      "🪄 Choice: {last_choice}"
    ]
  },
  "memory match": {
